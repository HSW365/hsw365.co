{% assign showcase_handles = 'merchandise,hoodstar365-music,hsw365-services' | split: ',' %}
<section class="hsw365-storefront">
  <div class="hsw365-intro">
    <p class="hsw365-eyebrow">THE OFFICIAL HSW365 STORE</p>
    <h1>HOODSTARWORLD</h1>
    <p>Merchandise. Music. Technology. Built from the journey.</p>
  </div>

  {% for handle in showcase_handles %}
    {% assign showcase = collections[handle] %}
    {% if showcase != blank and showcase.products_count > 0 %}
      <section class="hsw365-showcase" aria-label="{{ showcase.title | escape }}">
        <div class="hsw365-section-heading">
          <div>
            <p class="hsw365-eyebrow">HSW365 COLLECTION</p>
            <h2>{{ showcase.title }}</h2>
          </div>
          <a class="hsw365-view-all" href="{{ showcase.url }}">View all</a>
        </div>
        <div class="hsw365-product-grid">
          {% for product in showcase.products limit: 4 %}
            <a class="hsw365-product-card" href="{{ product.url }}">
              <div class="hsw365-product-image">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
                {% else %}
                  <span>HSW365</span>
                {% endif %}
              </div>
              <div class="hsw365-product-info">
                <h3>{{ product.title }}</h3>
                <p>{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</section>

<style>
  .hsw365-storefront {
    --hsw-ink: #282333;
    --hsw-paper: #fffaf4;
    --hsw-accent: #e85d45;
    background: var(--hsw-paper);
    color: var(--hsw-ink);
    padding: clamp(24px, 4vw, 56px) 0 64px;
  }
  .hsw365-intro,
  .hsw365-showcase {
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto;
  }
  .hsw365-intro {
    padding: 12px 0 34px;
    border-bottom: 1px solid rgba(40,35,51,.16);
  }
  .hsw365-eyebrow {
    margin: 0 0 8px;
    color: var(--hsw-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .hsw365-intro h1 {
    margin: 0;
    color: var(--hsw-ink);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -.035em;
  }
  .hsw365-intro > p:last-child {
    margin: 12px 0 0;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.5;
  }
  .hsw365-showcase {
    padding: 36px 0 8px;
  }
  .hsw365-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }
  .hsw365-section-heading h2 {
    margin: 0;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -.025em;
  }
  .hsw365-view-all {
    color: var(--hsw-ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .hsw365-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .hsw365-product-card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .hsw365-product-image {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f1ede7;
  }
  .hsw365-product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }
  .hsw365-product-image span {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .hsw365-product-info {
    padding: 10px 2px 0;
  }
  .hsw365-product-info h3 {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
  }
  .hsw365-product-info p {
    margin: 6px 0 0;
    font-size: 14px;
    font-weight: 700;
  }
  @media (max-width: 749px) {
    .hsw365-intro,
    .hsw365-showcase {
      width: calc(100% - 28px);
    }
    .hsw365-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
    }
    .hsw365-showcase {
      padding-top: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "HSW365 clean storefront",
  "settings": [],
  "presets": [
    {
      "name": "HSW365 clean storefront"
    }
  ]
}
{% endschema %}